{
  "name": "solitaire",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:he": "node scripts/use-lang.mjs he && vite",
    "dev:en": "node scripts/use-lang.mjs en && vite",
    "build": "node scripts/build-web.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:levels": "node scripts/check-levels.mjs",
    "check:solver": "node scripts/check-solver.mjs",
    "check:layout": "node --experimental-strip-types scripts/check-layout.ts",
    "check": "npm run typecheck && npm run check:solver && npm run check:levels && npm run check:layout"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "12.43.0",
    "lucide-react": "^0.545.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.2"
  }
}
